<!-- formatter STILL hates EJS, do later manually -->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Local Weather</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <header class="search-bar">
        <form action="/location" method="POST" class="address-form">
            <div class="form-field number-field">
                <label for="streetNumber">NUMBER</label>
                <input id="streetNumber" name="streetNumber" type="text" inputmode="numeric" pattern="[0-9]{1,10}"
                    maxlength="10" required>
            </div>
            <div class="form-field street-field">
                <label for="streetName">NAME</label>
                <input id="streetName" name="streetName" type="text" required>
            </div>
            <div class="form-field city-field">
                <label for="city">CITY</label>
                <input id="city" name="city" type="text" required>
            </div>
            <div class="form-field state-field">
                <label for="state">ST</label>
                <select id="state" name="state" required>
                    <option value="" selected disabled></option>
                    <option value="AL">AL</option>
                    <option value="AK">AK</option>
                    <option value="AZ">AZ</option>
                    <option value="AR">AR</option>
                    <option value="CA">CA</option>
                    <option value="CO">CO</option>
                    <option value="CT">CT</option>
                    <option value="DE">DE</option>
                    <option value="FL">FL</option>
                    <option value="GA">GA</option>
                    <option value="HI">HI</option>
                    <option value="ID">ID</option>
                    <option value="IL">IL</option>
                    <option value="IN">IN</option>
                    <option value="IA">IA</option>
                    <option value="KS">KS</option>
                    <option value="KY">KY</option>
                    <option value="LA">LA</option>
                    <option value="ME">ME</option>
                    <option value="MD">MD</option>
                    <option value="MA">MA</option>
                    <option value="MI">MI</option>
                    <option value="MN">MN</option>
                    <option value="MS">MS</option>
                    <option value="MO">MO</option>
                    <option value="MT">MT</option>
                    <option value="NE">NE</option>
                    <option value="NV">NV</option>
                    <option value="NH">NH</option>
                    <option value="NJ">NJ</option>
                    <option value="NM">NM</option>
                    <option value="NY">NY</option>
                    <option value="NC">NC</option>
                    <option value="ND">ND</option>
                    <option value="OH">OH</option>
                    <option value="OK">OK</option>
                    <option value="OR">OR</option>
                    <option value="PA">PA</option>
                    <option value="RI">RI</option>
                    <option value="SC">SC</option>
                    <option value="SD">SD</option>
                    <option value="TN">TN</option>
                    <option value="TX">TX</option>
                    <option value="UT">UT</option>
                    <option value="VT">VT</option>
                    <option value="VA">VA</option>
                    <option value="WA">WA</option>
                    <option value="WV">WV</option>
                    <option value="WI">WI</option>
                    <option value="WY">WY</option>
                </select>
            </div>
            <button type="submit" class="submit-button">Submit</button>
        </form>
    </header>
    <% if (error) { %>
        <div class="error">
            <%= error %>
        </div>
        <% } %>
            <% if (sections) { %>
                <main class="dashboard">
                    <aside class="category-selector">
                        <label class="category-option">
                            <input type="checkbox" checked data-section="weather">
                            <span class="checkbox"></span>
                            <span>Weather</span>
                        </label>
                        <label class="category-option">
                            <input type="checkbox" checked data-section="solar">
                            <span class="checkbox"></span>
                            <span>Solar</span>
                        </label>
                        <label class="category-option">
                            <input type="checkbox" checked data-section="soil">
                            <span class="checkbox"></span>
                            <span>Soil</span>
                        </label>
                        <label class="category-option">
                            <input type="checkbox" checked data-section="alerts">
                            <span class="checkbox"></span>
                            <span>Alerts</span>
                        </label>
                    </aside>
                    <section class="results">
                        <% if (sections.weather) { %>
                            <section class="info-section" data-section="weather">
                                <h2>Weather</h2>
                                <div class="info-grid">
                                    <% sections.weather.forEach(item=> { %>
                                        <div class="info-card">
                                            <div class="card-label">
                                                <%= item.label %>
                                            </div>
                                            <div class="card-value">
                                                <%= item.value %>
                                            </div>
                                        </div>
                                        <% }) %>
                                </div>
                            </section>
                            <% } %>
                                <% if (sections.solar) { %>
                                    <section class="info-section" data-section="solar">
                                        <h2>Solar</h2>
                                        <div class="info-grid">
                                            <% sections.solar.forEach(item=> { %>
                                                <div class="info-card">
                                                    <div class="card-label">
                                                        <%= item.label %>
                                                    </div>
                                                    <div class="card-value">
                                                        <%= item.value %>
                                                    </div>
                                                </div>
                                                <% }) %>
                                        </div>
                                    </section>
                                    <% } %>
                                        <% if (sections.soil) { %>
                                            <section class="info-section" data-section="soil">
                                                <h2>Soil</h2>
                                                <div class="info-grid">
                                                    <% sections.soil.forEach(item=> { %>
                                                        <div class="info-card">
                                                            <div class="card-label">
                                                                <%= item.label %>
                                                            </div>
                                                            <div class="card-value">
                                                                <%= item.value %>
                                                            </div>
                                                        </div>
                                                        <% }) %>
                                                </div>
                                            </section>
                                            <% } %>
                                                <% if (sections.alerts) { %>
                                                    <section class="info-section" data-section="alerts">
                                                        <h2>Alerts</h2>
                                                        <div class="info-grid">
                                                            <% if (sections.alerts.length===0) { %>
                                                                <div class="no-alerts">No active official alerts.</div>
                                                                <% } %>
                                                                    <% sections.alerts.forEach(item=> { %>
                                                                        <div class="info-card alert-card">
                                                                            <div class="card-label">
                                                                                <%= item.label %>
                                                                            </div>
                                                                            <div class="card-value">
                                                                                <%= item.value %>
                                                                            </div>
                                                                        </div>
                                                                        <% }) %>
                                                        </div>
                                                    </section>
                                                    <% } %>
                    </section>
                </main>
                <% } %>
                    <script>
                        const categoryInputs = document.querySelectorAll(".category-option input");
                        categoryInputs.forEach(input => {
                            input.addEventListener("change", () => {
                                const sectionName = input.dataset.section;
                                const sections = document.querySelectorAll(`section[data-section="${sectionName}"]`); // had to add section or it hid checkbox too
                                sections.forEach(section => {
                                    section.style.display = input.checked ? "" : "none";
                                });
                            });
                        });
                    </script>
</body>

</html>